<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefWidth="380" spacing="12" styleClass="card" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.ingsoft.bvasquez.quel.controller.LoginController">
    <padding><Insets bottom="30" left="30" right="30" top="30" /></padding>
    <Label styleClass="title" text="Iniciar sesión" />
   <TextField fx:id="txtUsuario" />
    <PasswordField fx:id="txtPassword" onAction="#onLogin" promptText="Contraseña" />
    <Button maxWidth="Infinity" onAction="#onLogin" styleClass="primary" text="Ingresar" />
    <Hyperlink onAction="#onIrRegistro" text="¿No tiene cuenta? Regístrese" />
</VBox>
