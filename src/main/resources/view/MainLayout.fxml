<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="650" prefWidth="1100" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.ingsoft.bvasquez.quel.controller.MainLayoutController">
   <left>
      <VBox prefWidth="190" spacing="10" styleClass="sidebar">
         <padding><Insets bottom="20" left="12" right="12" top="20" /></padding>
         <Label styleClass="sidebar-title" text="Reclutamiento" />
         <Label fx:id="lblUsuario" styleClass="sidebar-user" wrapText="true" />
         <Button maxWidth="Infinity" onAction="#onDashboard" text="Personas Registradas" />
         <Button maxWidth="Infinity" onAction="#onAspirantes" text="Aspirantes" />
         <Region VBox.vgrow="ALWAYS" />
         <Button maxWidth="Infinity" onAction="#onLogout" text="Cerrar sesión" />
      </VBox>
   </left>
   <center>
      <StackPane fx:id="contentPane" />
   </center>
</BorderPane>
