<?xml version="1.0" encoding="UTF-8"?>
<project name="GestionAspirantes" default="compile" basedir=".">
    <!-- Defina PATH_TO_FX con la carpeta lib del SDK de JavaFX (17 o superior) -->
    <property environment="env"/>
    <property name="javafx.lib" value="${env.PATH_TO_FX}"/>
    <property name="src.dir" value="src/main/java"/>
    <property name="res.dir" value="src/main/resources"/>
    <property name="build.dir" value="build/classes"/>
    <property name="lib.dir" value="lib"/>
    <property name="main.class" value="edu.ingsoft.colegio.gotitas.MainApp"/>
    <property name="fx.modules" value="javafx.controls,javafx.fxml"/>

    <path id="libs">
        <fileset dir="${lib.dir}" includes="*.jar"/>
    </path>

    <target name="clean">
        <delete dir="build"/>
        <delete dir="dist"/>
    </target>

    <target name="compile">
        <mkdir dir="${build.dir}"/>
        <javac srcdir="${src.dir}" destdir="${build.dir}" includeantruntime="false"
               release="17" encoding="UTF-8" classpathref="libs">
            <compilerarg line="--module-path ${javafx.lib} --add-modules ${fx.modules}"/>
        </javac>
        <copy todir="${build.dir}">
            <fileset dir="${res.dir}"/>
        </copy>
    </target>

    <target name="run" depends="compile">
        <java classname="${main.class}" fork="true">
            <classpath>
                <pathelement location="${build.dir}"/>
                <path refid="libs"/>
            </classpath>
            <jvmarg line="--module-path ${javafx.lib} --add-modules ${fx.modules}"/>
        </java>
    </target>
</project>
